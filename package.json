{
  "name": "importacion-validacion-datos",
  "version": "0.1.0",
  "private": true,
  "description": "API REST para importar y validar datos de productos en CSV.",
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/integration/**",
    "test:watch": "vitest --exclude tests/integration/**",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run tests/integration --maxWorkers=1",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/persistence/migrate-cli.ts",
    "db:local": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/local-postgres.ps1"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
